diff --git a/src/settings.cc b/src/settings.cc
index 2fc76f70..80f0df3a 100644
--- a/src/settings.cc
+++ b/src/settings.cc
@@ -150,7 +150,11 @@ void initSettingsRegistry(bool isMapper)
     SETTING(language);
     SETTING(scroll_lock);
     SETTING(interrupt_walk);
+#ifdef __PS4__
+    SETTING_P(art_cache_size, clamp(32, 64));
+#else
     SETTING_P(art_cache_size, clamp(32, 512));
+#endif
     SETTING(color_cycling);
     SETTING(cycle_speed_factor);
     SETTING(hashing);
@@ -307,6 +311,26 @@ bool settingsInit(bool isMapper, int argc, char** argv)
         descriptor.read();
     }
 
+#ifdef __PS4__
+    // On PS4 the game data and saves share one flat base: /data/fallout2 (the
+    // process cwd after the cred jailbreak). The stock config ships
+    // master_patches=data / critter_patches=data, which on desktop registers a
+    // "data" directory-xbase that bridges the save code's bare "SAVEGAME\..."
+    // opens to <patches>/SAVEGAME. That xbase does NOT register on this port, so
+    // the engine creates save dirs under /data/fallout2/data/SAVEGAME (via the
+    // patches prefix) but opens SAVE.DAT at /data/fallout2/SAVEGAME (the cwd
+    // fall-through) -> ENOENT, "Error opening save game for writing" (confirmed
+    // on-device 2026-07-07). Clearing the patches paths makes both the mkdir and
+    // the open resolve to the same /data/fallout2/SAVEGAME, which the boot
+    // write-probe proved is writable. Base game data still loads from the .dat
+    // archives (opened independently of these paths).
+    settings.system.master_patches_path.clear();
+    settings.system.critter_patches_path.clear();
+    if (settings.system.art_cache_size > 64) {
+        settings.system.art_cache_size = 64;
+    }
+#endif
+
     return true;
 }
 
