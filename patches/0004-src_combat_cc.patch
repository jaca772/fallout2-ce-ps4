+// PS4 gamepad aim assist: living, non-party critters the player can reach, sorted
+// nearest-first. Works both in combat (targets to shoot) and out of combat
+// (people to talk to / interact with). Every candidate must be:
+//   - a living critter, not the player or a party follower,
+//   - within an engine-derived range (in combat: the current weapon's range; out
+//     of combat: the player's perception reach), verified with engine functions,
+//   - in a clear line of sight (the same _combat_is_shot_blocked test used for the
+//     hostile outline),
+//   - and, unless wholeMap is set, currently on screen (in the player's viewport).
+// Safe to call from the input-poll path: plain reads + object-list walk only, no
+// scripts / _process_bk.
+int combatGamepadListTargets(Object** out, int maxCount, bool wholeMap)
+{
+    if (out == nullptr || maxCount <= 0 || gDude == nullptr) {
+        return 0;
+    }
+
+    bool inCombat = isInCombat();
+
+    // Engine-derived reach. In combat this is the equipped weapon's range for the
+    // current attack mode; out of combat, the perception reach (same value the
+    // engine uses for line-of-sight awareness).
+    int maxRange;
+    if (inCombat) {
+        int hitMode;
+        bool aiming;
+        if (interfaceGetCurrentHitMode(&hitMode, &aiming) == -1) {
+            maxRange = 1;
+        } else {
+            maxRange = weaponGetRange(gDude, hitMode);
+            // Melee / unarmed (reach 1-2): you close the distance on foot, so the
+            // weapon's reach must NOT gate the target list — otherwise no enemy is
+            // ever "in range" and melee aim finds nothing. Use the perception reach
+            // so any enemy you could walk up to is targetable (the reach+attack AP
+            // cost is shown on the reticle message).
+            if (maxRange <= 2) {
+                maxRange = critterGetStat(gDude, STAT_PERCEPTION) * 5;
+            }
+        }
+    } else {
+        maxRange = critterGetStat(gDude, STAT_PERCEPTION) * 5;
+    }
+    if (maxRange < 1) {
+        maxRange = 1;
+    }
+
+    // Candidate source. In combat _combat_list already holds every critter on the
+    // elevation (_list_total); out of combat build a fresh critter list.
+    Object** list;
+    int listLen;
+    bool freeList = false;
+    if (inCombat) {
+        list = _combat_list;
+        listLen = _list_total;
+        if (list == nullptr) {
+            return 0;
+        }
+    } else {
+        listLen = objectListCreate(-1, gElevation, OBJ_TYPE_CRITTER, &list);
+        freeList = true;
+    }
+
+    int logicalW = screenGetWidth();
+    int visibleH = screenGetVisibleHeight();
+
+    int count = 0;
+    for (int i = 0; i < listLen && count < maxCount; i++) {
+        Object* c = list[i];
+        if (c == nullptr || c == gDude) {
+            continue;
+        }
+        if (FID_TYPE(c->fid) != OBJ_TYPE_CRITTER) {
+            continue;
+        }
+        if ((c->data.critter.combat.results & (DAM_DEAD | DAM_KNOCKED_OUT)) != 0) {
+            continue;
+        }
+        if (objectIsPartyMember(c)) {
+            continue; // companion/follower — not a target
+        }
+        // Reachable within range (engine range vs tile distance).
+        if (objectGetDistanceBetween(gDude, c) > maxRange) {
+            continue;
+        }
+        // Clear line of sight (same test as the hostile outline / shot check).
+        if (_combat_is_shot_blocked(gDude, gDude->tile, c->tile, c, nullptr)) {
+            continue;
+        }
+        // Viewport filter: unless searching the whole map, the target's tile must
+        // be on screen in the play area.
+        if (!wholeMap) {
+            int sx, sy;
+            if (tileToScreenXY(c->tile, &sx, &sy) != 0) {
+                continue;
+            }
+            if (sx < 0 || sx >= logicalW || sy < 0 || sy >= visibleH) {
+                continue;
+            }
+        }
+        out[count++] = c;
+    }
+
+    if (freeList && listLen != 0) {
+        objectListFree(list);
+    }
+
+    // Insertion sort by distance to the player (nearest first).
+    for (int i = 1; i < count; i++) {
+        Object* key = out[i];
+        int keyDist = objectGetDistanceBetween(gDude, key);
+        int j = i - 1;
+        while (j >= 0 && objectGetDistanceBetween(gDude, out[j]) > keyDist) {
+            out[j + 1] = out[j];
+            j--;
+        }
+        out[j + 1] = key;
+    }
+
+    return count;
+}
+
+// PS4 gamepad loot/interact assist: fill `out` (up to maxCount) with nearby
+// interactable objects — containers, corpses (dead critters) and doors — within
+// `maxTiles` of the dude, nearest-first. When `skipEmpty`, containers/corpses that
+// hold nothing are omitted (doors are always listed). Mirrors
+// combatGamepadListTargets, but for opening/looting rather than attacking, so it is
+// range-capped by a config distance and does not require a clear line of fire.
+int gamepadListInteractables(Object** out, int maxCount, bool wholeMap, int maxTiles, bool skipEmpty)
+{
+    if (out == nullptr || maxCount <= 0 || gDude == nullptr) {
+        return 0;
+    }
+    if (maxTiles < 1) {
+        maxTiles = 1;
+    }
+
+    int logicalW = screenGetWidth();
+    int visibleH = screenGetVisibleHeight();
+    int count = 0;
+
+    static const int kTypes[] = { OBJ_TYPE_ITEM, OBJ_TYPE_CRITTER, OBJ_TYPE_SCENERY };
+    for (int t = 0; t < 3 && count < maxCount; t++) {
+        Object** list;
+        int listLen = objectListCreate(-1, gElevation, kTypes[t], &list);
+        for (int i = 0; i < listLen && count < maxCount; i++) {
+            Object* o = list[i];
+            if (o == nullptr || o == gDude) {
+                continue;
+            }
+            if ((o->flags & OBJECT_HIDDEN) != 0) {
+                continue;
+            }
+
+            bool keep = false;
+            switch (kTypes[t]) {
+            case OBJ_TYPE_ITEM:
+                if (itemGetType(o) == ITEM_TYPE_CONTAINER) {
+                    keep = !(skipEmpty && o->data.inventory.length == 0);
+                }
+                break;
+            case OBJ_TYPE_CRITTER:
+                if ((o->data.critter.combat.results & DAM_DEAD) != 0) {
+                    keep = !(skipEmpty && o->data.inventory.length == 0);
+                }
+                break;
+            case OBJ_TYPE_SCENERY: {
+                Proto* proto;
+                if (protoGetProto(o->pid, &proto) != -1 && proto->scenery.type == SCENERY_TYPE_DOOR) {
+                    // Only closed doors are worth snapping to (open/close, lockpick);
+                    // skip ones already open. openFlags bit 0 is the engine's own
+                    // door-open state (see proto_instance.cc).
+                    keep = (o->data.scenery.door.openFlags & 0x01) == 0;
+                }
+                break;
+            }
+            }
+            if (!keep) {
+                continue;
+            }
+
+            if (objectGetDistanceBetween(gDude, o) > maxTiles) {
+                continue;
+            }
+            if (!wholeMap) {
+                int sx, sy;
+                if (tileToScreenXY(o->tile, &sx, &sy) != 0) {
+                    continue;
+                }
+                if (sx < 0 || sx >= logicalW || sy < 0 || sy >= visibleH) {
+                    continue;
+                }
+            }
+            out[count++] = o;
+        }
+        if (listLen != 0) {
+            objectListFree(list);
+        }
+    }
+
+    // Insertion sort by distance to the player (nearest first).
+    for (int i = 1; i < count; i++) {
+        Object* key = out[i];
+        int keyDist = objectGetDistanceBetween(gDude, key);
+        int j = i - 1;
+        while (j >= 0 && objectGetDistanceBetween(gDude, out[j]) > keyDist) {
+            out[j + 1] = out[j];
+            j--;
+        }
+        out[j + 1] = key;
+    }
+
+    return count;
+}
