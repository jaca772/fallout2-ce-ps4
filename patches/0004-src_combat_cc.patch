+// PS4 gamepad: true while the called-shot (VATS) body-part window is up, so the
+// pad code stops hijacking the cursor and lets the modal be clicked/cancelled.
+bool combatGamepadCalledShotActive()
+{
+    return gCalledShotWindowActive;
+}
+
+// PS4 gamepad: true when combat can be ended right now (no living, hostile,
+// still-engaging critter remains). Used by the "combat" action (R3): safe -> end
+// fight, else -> end turn.
+//
+// IMPORTANT: this runs from the input-poll path (mid-frame, re-entrant), so it
+// must do ONLY plain field reads. It deliberately does NOT call the engine's
+// _combatai_want_to_stop/_want_to_join helpers — those run _process_bk() and even
+// execute the critter's combat script (scriptExecProc), which corrupts engine
+// state when invoked re-entrantly and segfaults. Instead it mirrors the same
+// hostility test as combatAttemptEnd with simple reads and treats dead/knocked-
+// out and fleeing/disengaging critters as non-threats.
+bool combatGamepadCanEndCombat()
+{
+    if (!isInCombat() || _combat_list == nullptr) {
+        return false;
+    }
+
+    int dudeTeam = gDude->data.critter.combat.team;
+    int total = _list_com + _list_noncom;
+    for (int index = 0; index < total; index++) {
+        Object* critter = _combat_list[index];
+        if (critter == nullptr || critter == gDude) {
+            continue;
+        }
+        if (FID_TYPE(critter->fid) != OBJ_TYPE_CRITTER) {
+            continue;
+        }
+        // Dead / unconscious critters are no threat.
+        if ((critter->data.critter.combat.results & (DAM_DEAD | DAM_KNOCKED_OUT)) != 0) {
+            continue;
+        }
+        // Fleeing or disengaging critters are leaving the fight.
+        if ((critter->data.critter.combat.maneuver & (CRITTER_MANUEVER_FLEEING | CRITTER_MANEUVER_DISENGAGING)) != 0) {
+            continue;
+        }
+        // Hostile? Different team, or provoked (was hit by someone on its team,
+        // i.e. the player) — same condition combatAttemptEnd uses.
+        int critterTeam = critter->data.critter.combat.team;
+        Object* critterWhoHitMe = critter->data.critter.combat.whoHitMe;
+        bool hostile = critterTeam != dudeTeam
+            || (critterWhoHitMe != nullptr && critterWhoHitMe->data.critter.combat.team == critterTeam);
+        if (hostile) {
+            return false; // a living hostile still in the fight -> not safe to end
+        }
+    }
+    return true;
+}
+
+// PS4 gamepad: force a called-shot (aimed) attack, reusing the engine's body-part
+// selection UI and validation, regardless of the weapon's current aimed toggle.
+void combatGamepadAimedAttack(Object* target)
+{
+    if (target == nullptr || (gCombatState & COMBAT_STATE_PLAYER_TURN) == 0) {
+        return;
+    }
+
+    int hitMode;
+    bool aiming;
+    if (interfaceGetCurrentHitMode(&hitMode, &aiming) == -1) {
+        return;
+    }
+
+    // Validate as an aimed shot; on any problem fall back to the normal path so
+    // its message ("out of range", "out of ammo", ...) is shown.
+    if (_combat_check_bad_shot(gDude, target, hitMode, true) != COMBAT_BAD_SHOT_OK) {
+        _combat_attack_this(target);
+        return;
+    }
+
+    int hitLocation;
+    if (calledShotSelectHitLocation(target, &hitLocation, hitMode) != -1) {
+        _combat_attack(gDude, target, hitMode, hitLocation);
+    }
+}
+
+// Gamepad melee/unarmed: run up to the target, then (optionally) attack.
+//
+// The normal player attack (_combat_attack_this) refuses an out-of-range
+// target with "Target out of range" and stops. The enemy AI instead walks up
+// and then swings (_ai_move_steps_closer + _ai_attack, each blocking via
+// _combat_turn_run). We mirror that for the dude: register a run/walk-to-object
+// move, drain the animation queue synchronously, then run the normal attack —
+// which now sees us adjacent. If AP only covered part of the way, the attack
+// simply reports out-of-range like the AI would (moved what it could).
+//
+// attackAfter == false stops after the approach (run-up only, no swing).
+void combatGamepadApproachAndAttack(Object* target, bool attackAfter)
+{
+    if (target == nullptr || (gCombatState & COMBAT_STATE_PLAYER_TURN) == 0) {
+        return;
+    }
+
+    if (objectGetDistanceBetween(gDude, target) > 1) {
+        int actionPoints = gDude->data.critter.combat.ap;
+        if (actionPoints <= 0) {
+            // no AP to move: let the normal path show "out of range"
+            if (attackAfter) {
+                _combat_attack_this(target);
+            }
+            return;
+        }
+
+        reg_anim_begin(ANIMATION_REQUEST_RESERVED);
+        if (actionPoints >= critterGetStat(gDude, STAT_MAXIMUM_ACTION_POINTS) / 2
+            && artCritterFidShouldRun(gDude->fid)) {
+            animationRegisterRunToObject(gDude, target, actionPoints, 0);
+        } else {
+            animationRegisterMoveToObject(gDude, target, actionPoints, 0);
+        }
+        if (reg_anim_end() != 0) {
+            return;
+        }
+
+        _combat_turn_run();
+    }
+
+    // Now (hopefully) adjacent. Run-up-only mode stops here; otherwise do the
+    // normal attack, which re-checks range/AP and shows the usual message if we
+    // still fell short.
+    if (attackAfter) {
+        _combat_attack_this(target);
+    }
+}
