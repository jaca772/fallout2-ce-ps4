 static bool createRenderer(int width, int height)
 {
+#ifdef __PS4__
+    // Native path: no SDL renderer/texture. Open sceVideoOut and allocate the
+    // software present surface the engine blits into.
+    if (!ps4VideoInit(width, height)) {
+        return false;
+    }
+    gSdlTextureSurface = SDL_CreateRGBSurfaceWithFormat(0, width, height, 32, SDL_PIXELFORMAT_RGB888);
+    if (gSdlTextureSurface == nullptr) {
+        return false;
+    }
+    return true;
+#else
     gSdlRenderer = SDL_CreateRenderer(gSdlWindow, -1, 0);
     if (gSdlRenderer == nullptr) {
