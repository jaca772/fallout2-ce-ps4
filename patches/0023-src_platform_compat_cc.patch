+#ifdef __PS4__
+// PS4's filesystem is case-sensitive, but Fallout 2's data mixes case (the engine
+// asks for `data\sound\music\...` while a real install may hold `SOUND`/`Sound`).
+// Resolve `path` (absolute) against the real on-disk names, matching each
+// component case-insensitively via a directory scan. Fills `out` and returns true
+// on a full match; false otherwise. Exact components hit the fast access() path,
+// so this only scans where the case actually differs. Removes the old manual
+// "rename sound to uppercase" step — any casing now just works.
+static bool ps4ResolveCaseInsensitiveImpl(const char* path, char* out, size_t outSize)
+{
+    if (path == nullptr || path[0] != '/') {
+        return false;
+    }
+
+    // Fast path: the exact path already exists (the common case after a first
+    // successful resolution or when the caller's casing already matches disk).
+    // One access() instead of a per-component directory scan.
+    if (access(path, F_OK) == 0) {
+        strncpy(out, path, outSize - 1);
+        out[outSize - 1] = '\0';
+        return true;
+    }
+
+    char resolved[COMPAT_MAX_PATH];
+    resolved[0] = '/';
+    resolved[1] = '\0';
+    size_t rlen = 1; // length of `resolved` ("/" => 1)
+    const char* p = path + 1;
+
+    while (*p != '\0') {
+        const char* slash = strchr(p, '/');
+        size_t complen = slash != nullptr ? (size_t)(slash - p) : strlen(p);
+        if (complen == 0) { // collapse "//"
+            p = (slash != nullptr) ? slash + 1 : p + complen;
+            continue;
+        }
+        if (complen >= 256 || rlen + 1 + complen >= sizeof(resolved)) {
+            // Best-effort: keep the resolved parent prefix + the unresolved tail.
+            snprintf(out, outSize, "%s%s%s", resolved, rlen == 1 ? "" : "/", p);
+            return false;
+        }
+
+        char comp[256];
+        memcpy(comp, p, complen);
+        comp[complen] = '\0';
+
+        char candidate[COMPAT_MAX_PATH];
+        if (rlen == 1) {
+            snprintf(candidate, sizeof(candidate), "/%s", comp);
+        } else {
+            snprintf(candidate, sizeof(candidate), "%s/%s", resolved, comp);
+        }
+
+        if (access(candidate, F_OK) == 0) {
+            strcpy(resolved, candidate);
+        } else {
+            DIR* dir = opendir(resolved);
+            bool found = false;
+            if (dir != nullptr) {
+                struct dirent* entry;
+                while ((entry = readdir(dir)) != nullptr) {
+                    if (SDL_strcasecmp(entry->d_name, comp) == 0) {
+                        if (rlen == 1) {
+                            snprintf(candidate, sizeof(candidate), "/%s", entry->d_name);
+                        } else {
+                            snprintf(candidate, sizeof(candidate), "%s/%s", resolved, entry->d_name);
+                        }
+                        found = true;
+                        break;
+                    }
+                }
+                closedir(dir);
+            }
+            if (!found) {
+                // The tail does not exist yet (a new save file or subdirectory).
+                // Emit the resolved existing parent prefix + the unresolved tail so
+                // a subsequent create/write lands in the case-corrected directory
+                // instead of ENOENT-ing on a differently-cased member.
+                snprintf(out, outSize, "%s%s%s", resolved, rlen == 1 ? "" : "/", p);
+                return false;
+            }
+            strcpy(resolved, candidate);
+        }
+        rlen = strlen(resolved);
+
+        if (slash == nullptr) {
+            break;
+        }
+        p = slash + 1;
+    }
+
+    strncpy(out, resolved, outSize - 1);
+    out[outSize - 1] = '\0';
+    return true;
+}
+
+bool ps4ResolveCaseInsensitive(const char* path, char* out, size_t outSize)
+{
+    uint64_t t0 = sceKernelGetProcessTime();
+    bool res = ps4ResolveCaseInsensitiveImpl(path, out, outSize);
+    uint64_t dt = sceKernelGetProcessTime() - t0;
+
+    static uint32_t s_resolveCalls = 0;
+    static uint32_t s_resolveHits = 0;
+    static uint64_t s_totalUs = 0;
+
+    s_resolveCalls++;
+    if (res) {
+        s_resolveHits++;
+    }
+    s_totalUs += dt;
+
+    if (s_resolveCalls % 100 == 0 || dt >= 5000) {
+        ps4Log("[ps4] case-resolve: %u calls (%u hits, %u misses), avg %lu us, last %lu us%s\n",
+               s_resolveCalls, s_resolveHits, s_resolveCalls - s_resolveHits,
+               (unsigned long)(s_totalUs / s_resolveCalls), (unsigned long)dt,
+               dt >= 5000 ? " [SLOW]" : "");
+    }
+
+    return res;
+}
+#endif
+
 static void compat_prepare_native_path(char* nativePath, const char* path)
 {
+#ifdef __PS4__
+    // On PS4 we jailbreak to prison0 to access game data in /data. However, the cred
+    // swap breaks getcwd() (returns NULL / EINVAL), which in turn breaks the
+    // toolchain libc's relative path resolution in fopen/open/opendir.
+    // Prepend the absolute base path to all relative paths to bypass this.
+    if (path[0] != '/' && path[0] != '\0') {
+        snprintf(nativePath, COMPAT_MAX_PATH, "%s/%s", ps4GetDataPath(), path);
+    } else {
+        strncpy(nativePath, path, COMPAT_MAX_PATH - 1);
+        nativePath[COMPAT_MAX_PATH - 1] = '\0';
+    }
+    compat_windows_path_to_native(nativePath);
+
+    // Resolve the now-absolute path against real on-disk casing for every path
+    // consumer (fopen/gzopen/mkdir/remove/rename/access/is_dir/file_exists). The
+    // old compat_resolve_path is a no-op on PS4 (its directory cache is empty),
+    // which left case-insensitivity to a per-call read-miss retry in compat_fopen
+    // only — writes and directory enumeration still ENOENT-ed on wrong-cased paths.
+    char resolved[COMPAT_MAX_PATH];
+    ps4ResolveCaseInsensitive(nativePath, resolved, sizeof(resolved));
+    strncpy(nativePath, resolved, COMPAT_MAX_PATH - 1);
+    nativePath[COMPAT_MAX_PATH - 1] = '\0';
+#else
     strncpy(nativePath, path, COMPAT_MAX_PATH - 1);
     nativePath[COMPAT_MAX_PATH - 1] = '\0';
     compat_windows_path_to_native(nativePath);
     compat_resolve_path(nativePath);
+#endif
 }
 
