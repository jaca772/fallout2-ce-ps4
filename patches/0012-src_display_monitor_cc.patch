+// use instead, after the runtime is fully up.
+static std::ofstream& consoleFileStream()
+{
+    static std::ofstream stream;
+    return stream;
+}
 static int gConsoleFilePrintCount = 0;
 
 // 0x431610 display_init
@@ -441,29 +454,43 @@ static void consoleFileInit()
 {
     const std::string& consolePath = settings.debug.console_output_path;
     if (!consolePath.empty()) {
-        gConsoleFileStream.open(consolePath);
+#ifdef __PS4__
+        // Same write guard as compat_fopen; getcwd() is unusable after the cred
+        // jailbreak, so resolve relative paths against the game directory.
+        std::string nativePath = consolePath;
+        if (nativePath[0] != '/') {
+            nativePath = std::string(ps4GetDataPath()) + "/" + nativePath;
+        }
+        if (!ps4IsPathWritable(nativePath.c_str())) {
+            ps4Log("[ps4] Security: blocked console_output_path outside game dir\n");
+            return;
+        }
+        consoleFileStream().open(nativePath);
+#else
+        consoleFileStream().open(consolePath);
+#endif
     }
 }
 
