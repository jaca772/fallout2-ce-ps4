 FILE* compat_fopen(const char* path, const char* mode)
 {
     bool mayWrite = compatFileModeMayWrite(mode);
@@ -384,6 +488,15 @@ FILE* compat_fopen(const char* path, const char* mode)
     char nativePath[COMPAT_MAX_PATH];
     compat_prepare_native_path(nativePath, path);
     FILE* stream = fopen(nativePath, mode);
+#ifdef __PS4__
+    // Case-insensitive retry on a read miss (see ps4ResolveCaseInsensitive).
+    if (stream == nullptr && strchr(mode, 'r') != nullptr) {
+        char resolved[COMPAT_MAX_PATH];
+        if (ps4ResolveCaseInsensitive(nativePath, resolved, sizeof(resolved))) {
+            stream = fopen(resolved, mode);
+        }
+    }
+#endif
     if (mayWrite && stream != nullptr) {
         compatDirectoryEntryCacheClear();
     }
