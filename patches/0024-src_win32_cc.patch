diff --git a/src/win32.cc b/src/win32.cc
index 36f04545..73f6a18b 100644
--- a/src/win32.cc
+++ b/src/win32.cc
@@ -30,6 +30,10 @@
 #include "platform/ios/paths.h"
 #endif
 
+#ifdef __PS4__
+#include "platform/ps4/ps4.h"
+#endif
+
 // explicit `atexit` group
 #include "audio_engine.h"
 
@@ -101,9 +105,20 @@ int main(int argc, char* argv[])
     chdir(SDL_AndroidGetExternalStoragePath());
 #endif
 
+#ifdef __PS4__
+    // Native sceVideoOut path: do NOT init SDL video.
+    // Input (joystick/gamecontroller) + events stay on SDL; audio is deferred to
+    // audioEngineInit() (SDL_InitSubSystem AUDIO).
+    if (SDL_Init(SDL_INIT_JOYSTICK | SDL_INIT_GAMECONTROLLER | SDL_INIT_EVENTS) != 0) {
+        ps4Log("[ps4] SDL_Init(JOYSTICK|GAMECONTROLLER|EVENTS) FAILED: %s\n", SDL_GetError());
+        return EXIT_FAILURE;
+    }
+    ps4Log("[ps4] SDL_Init(JOYSTICK|GAMECONTROLLER|EVENTS) ok\n");
+#else
     if (SDL_Init(SDL_INIT_AUDIO | SDL_INIT_VIDEO | SDL_INIT_EVENTS) != 0) {
         return EXIT_FAILURE;
     }
+#endif
 
     atexit([] {
         audioEngineExit();
@@ -112,11 +127,51 @@ int main(int argc, char* argv[])
 
     SDL_ShowCursor(SDL_DISABLE);
 
+#ifdef __PS4__
+    // Mount /data and select game folder (via credential jailbreak in ps4MountData).
+    // This runs after SDL_Init so that SDL's event/joystick initialization has
+    // completed before any filesystem jailbreak occurs.
+    if (!ps4MountData()) {
+        ps4Log("[ps4] ps4MountData failed, exiting\n");
+        return EXIT_FAILURE;
+    }
+
+    // Initialize early video present surface at the resolution the engine will use
+    // (from fallout2.cfg / f2_res.ini), NOT a hardcoded 640x480.
+    int ps4ResX, ps4ResY, ps4Scale;
+    ps4ReadDisplayConfig(&ps4ResX, &ps4ResY, &ps4Scale);
+
+    // Load user-tunable gamepad settings (touch sensitivity, deadzones, etc.).
+    ps4ReadControlsConfig();
+
+    int ps4WinW = ps4ResX;
+    int ps4WinH = ps4ResY;
+    int ps4WinScale = ps4Scale;
+    if (ps4WinW / ps4WinScale < 640 || ps4WinH / ps4WinScale < 480) {
+        ps4WinScale = 1;
+    } else {
+        ps4WinW /= ps4WinScale;
+        ps4WinH /= ps4WinScale;
+    }
+
+    if (_GNW95_init_window(ps4WinW, ps4WinH, WindowMode::Fullscreen, ps4WinScale) == -1) {
+        ps4Log("[ps4] early video bootstrap FAILED\n");
+        return EXIT_FAILURE;
+    }
+    ps4Log("[ps4] early video bootstrap ok (%dx%d scale=%d)\n", ps4WinW, ps4WinH, ps4WinScale);
+#endif
+
     gProgramIsActive = true;
 #ifdef FALLOUT_MAPPER
     rc = mapper_main(argc, argv);
 #else
+#ifdef __PS4__
+    ps4Log("[ps4] entering falloutMain\n");
+#endif
     rc = falloutMain(argc, argv);
+#ifdef __PS4__
+    ps4Log("[ps4] falloutMain returned %d\n", rc);
+#endif
 #endif
 
 #if _WIN32
